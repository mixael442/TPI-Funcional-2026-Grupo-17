transicion :: String -> String -> [String]

transicion colorActual cambiarA

    -- Validación del color actual
    | colorActual /= "en-rojo"
      && colorActual /= "en-amarillo"
      && colorActual /= "en-verde"
      && colorActual /= "rojo-intermitente"
      && colorActual /= "amarillo-intermitente"
      && colorActual /= "verde-intermitente"
        = ["ERROR: color actual invalido"]

    -- Validación del color destino
    | cambiarA /= "rojo"
      && cambiarA /= "amarillo"
      && cambiarA /= "verde"
      && cambiarA /= "rojo-intermitente"
      && cambiarA /= "amarillo-intermitente"
      && cambiarA /= "verde-intermitente"
        = ["ERROR: color destino invalido"]

    -- Transiciones intermitentes

    | colorActual == "en-rojo"
      && cambiarA == "rojo-intermitente"
        = [colorActual, "activar-rojo-intermitente"]

    | colorActual == "rojo-intermitente"
      && cambiarA == "verde"
        = [colorActual, "cambiar-a-verde"]

    | colorActual == "en-verde"
      && cambiarA == "verde-intermitente"
        = [colorActual, "activar-verde-intermitente"]

    | colorActual == "verde-intermitente"
      && cambiarA == "amarillo"
        = [colorActual, "cambiar-a-amarillo"]

    | colorActual == "en-amarillo"
      && cambiarA == "amarillo-intermitente"
        = [colorActual, "activar-amarillo-intermitente"]

    | colorActual == "amarillo-intermitente"
      && cambiarA == "rojo"
        = [colorActual, "cambiar-a-rojo"]

    -- Transiciones normales

    | cambiarA == "rojo"
        = [colorActual, "cambiar-a-rojo"]

    | cambiarA == "amarillo"
        = [colorActual, "cambiar-a-amarillo"]

    | cambiarA == "verde"
        = [colorActual, "cambiar-a-verde"]

    | otherwise
        = [colorActual, "accion-por-defecto"]


main :: IO ()
main = do

    putStrLn "===== SEMAFORO INTELIGENTE ====="

    putStrLn "Ingrese el color actual:"
    colorActual <- getLine

    putStrLn "Valores posibles:"
    putStrLn "en-rojo"
    putStrLn "en-amarillo"
    putStrLn "en-verde"
    putStrLn "rojo-intermitente"
    putStrLn "amarillo-intermitente"
    putStrLn "verde-intermitente"

    putStrLn "Ingrese el color destino:"
    cambiarA <- getLine

    print (transicion colorActual cambiarA)